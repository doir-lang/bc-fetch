{
  "name": "bc-fetch",
  "description": "HTTP, JSON and JSON-RPC for -betterC D",
  "targetType": "staticLibrary",
  "toolchainRequirements": {
    "dmd": "no"
  },
  "sourcePaths": [
    "source"
  ],
  "importPaths": [
    "source"
  ],
  "dependencies": {
    "bc-threads": {
      "repository": "git+https://github.com/doir-lang/bc-threads.git",
      "version": "5c3cf45b5041e6b10f247d25430e62c581786bab"
    },
    "libfp": {
      "repository": "git+https://github.com/doir-lang/libfp.git",
      "version": "8e70b86a1b8ced0236b085fbf3bcb2c2a5788aa1"
    }
  },
  "dflags-ldc": [
    "-betterC",
    "-checkaction=C"
  ],
  "configurations": [
    {
      "name": "library",
      "targetType": "staticLibrary"
    },
    {
      "name": "unittest",
      "targetType": "executable",
      "mainSourceFile": "tests/runner.d",
      "sourcePaths": [
        "tests"
      ],
      "importPaths": [
        "tests"
      ]
    }
  ],
  "libs-posix": [
    "ssl",
    "crypto"
  ],
  "libs-windows": [
    "ws2_32",
    "secur32",
    "crypt32"
  ]
}
