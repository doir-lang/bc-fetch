  "targetType": "staticLibrary",
  "toolchainRequirements": {
    "dmd": "no"
  },
  "sourcePaths": [
    "source"
  ],
  "importPaths": [
    "source"
  ],
  "dependencies": {
    "bc-threads": {
      "repository": "git+https://github.com/doir-lang/bc-thread.git",
      "version": "3b33cde42ec0e28dfafcfa288156f023dcbca700"
    }
  },
  "dflags-ldc": [
    "-betterC",
    "-checkaction=C"
