{
  "name": "bc-fetch",
  "description": "HTTP, JSON and JSON-RPC for -betterC D",
  "targetType": "staticLibrary",
  "toolchainRequirements": {
    "dmd": "no"
  },
  "sourcePaths": [
    "source"
  ],
  "importPaths": [
    "source"
  ],
  "dependencies": {
    "bc-threads": {
      "repository": "git+https://github.com/doir-lang/bc-threads.git",
      "version": "0435e465cddd3967b8f2f4ad5f7539e8c74a0833"
    },
    "libfp": {
      "repository": "git+https://github.com/doir-lang/libfp.git",
      "version": "98472ff82e10f2b6138aeecab5735fc4637724a2"
    }
  },
  "dflags-ldc": [
    "-betterC",
    "-checkaction=C"
  ],
  "configurations": [
    {
      "name": "library",
      "targetType": "staticLibrary"
    },
    {
      "name": "unittest",
      "targetType": "executable",
      "mainSourceFile": "tests/runner.d",
      "sourcePaths": [
        "tests"
      ],
      "importPaths": [
        "tests"
      ]
    }
  ],
  "libs-posix": [
    "ssl",
    "crypto"
  ],
  "libs-windows": [
    "ws2_32",
    "secur32",
    "crypt32"
  ]
}
